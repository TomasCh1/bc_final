# Copy to .env and adjust for your machine:
# Used by: docker compose (env_file + variable substitution) and mvn spring-boot:run (optional import).

# --- Docker Compose: PostgreSQL container ---
POSTGRES_DB=chmelan_bc_db
POSTGRES_USER=chmelan_bc_user
POSTGRES_PASSWORD=change_me

# --- Maven / local PostgreSQL on host (profile: local) ---
DB_URL=jdbc:postgresql://localhost:5432/BC_DB
DB_USERNAME=postgres
DB_PASSWORD=change_me

# --- Security (required for both Docker and Maven) ---
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRATION=86400000

# --- Local dev CORS (Docker profile reads this from env_file) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- App URLs ---
APP_FRONTEND_BASE_URL=http://localhost:8080

# --- SMTP (optional locally; leave empty to log reset links instead of sending mail) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@localhost
PASSWORD_RESET_EMAIL_DISABLED=true

# --- Optional ---
ALLOW_TEST_ENDPOINTS=true
